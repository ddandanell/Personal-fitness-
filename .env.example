# Optional. When set, the public site loads GA4 and records WhatsApp clicks as whatsapp_click.
VITE_GA_MEASUREMENT_ID=

# Enquiry delivery. Set these in Vercel for Production (and Preview if you want the form to send there).
# Do not prefix them with VITE_. They must stay on the server.
# The form posts to /api/enquiry and delivers to hello@personalfitness.id with the visitor as Reply-To.
# If neither provider below is configured, the form stays on the page and shows hello@personalfitness.id.

# Preferred: Resend. Verify the personalfitness.id domain in Resend before sending.
RESEND_API_KEY=

# Optional sender. Must use a domain verified in Resend. Default: PersonalFitness.id <hello@personalfitness.id>
ENQUIRY_FROM_EMAIL=

# Optional inbox. Default: hello@personalfitness.id
ENQUIRY_TO_EMAIL=

# Alternative when RESEND_API_KEY is empty: Google Workspace or Gmail SMTP.
# Use an app password. SMTP_PORT must be 465 (implicit TLS) or 587 (STARTTLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=hello@personalfitness.id
# SMTP_PASS=

# Optional. When these are set on the Vercel /api/enquiry function, validated
# submissions are also inserted into Supabase (public.inquiries for guest
# contact, quote and schedule forms; public.partner_signups for partner interest).
# Use the project URL and the publishable/anon key only. Never add the service
# role, secret, JWT secret, or database password. If the insert fails, the
# existing email and WhatsApp flow still goes through.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=  # accepted as an alias of SUPABASE_PUBLISHABLE_KEY

